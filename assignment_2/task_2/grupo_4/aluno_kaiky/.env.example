# Copy to .env and fill in your values (do not commit .env).
# Use the same RDS/classicmodels credentials as in your lab; each task keeps its own copy.

AWS_REGION=us-east-1

# RDS instance identifier (Terraform discovers hostname via AWS API).
RDS_DB_INSTANCE_IDENTIFIER=classicmodels-mysql-g4

DB_NAME=classicmodels
DB_USER=admin
DB_PASSWORD=your_password_here

# Optional — defaults match terraform/variables.tf
# GLUE_ROLE_NAME=LabRole
# EVENTBRIDGE_ENABLED=true
# GLUE_SCHEDULE_CRON=cron(0 12 ? * MON *)
