# ═══════════════════════════════════════════════════════════════════════
# .env.example — Copie para .env e preencha com suas credenciais.
# NUNCA commite o arquivo .env com senhas reais!
# ═══════════════════════════════════════════════════════════════════════

# ── Opção 1: AWS Secrets Manager (recomendado) ───────────────────────
# Se definido, SECRET_ARN tem prioridade sobre todas as demais variáveis.
# SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789:secret:classicmodels-xyz
# AWS_REGION=us-east-1

# ── Opção 2: Variáveis diretas ───────────────────────────────────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_password_here
DB_NAME=classicmodels
