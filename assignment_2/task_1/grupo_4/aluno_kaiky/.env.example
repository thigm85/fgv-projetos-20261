# Copy to .env — DB_PASSWORD must match RDS master password from Task 1 provision.
# Leave DB_HOST empty to resolve from AWS on first run.

DB_HOST=
DB_PORT=3306
DB_NAME=classicmodels
DB_USER=admin
DB_PASSWORD=your_password_here

RDS_DB_INSTANCE_IDENTIFIER=classicmodels-mysql-g4
AWS_REGION=us-east-1

SIMULATE_ORDER_COUNT=5
