# Copy this file to .env and fill the values from AWS Academy.
# Never put real credentials in .env.example.
# The real .env file is ignored by git.

# AWS Academy credentials. Paste these from "AWS Details" / "AWS CLI".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS region used by the lab.
AWS_REGION=us-east-1

# Naming prefix for generated Glue/S3 resources.
PROJECT_NAME=grupo5-task3

# RDS MySQL database that the script will create or reuse.
RDS_INSTANCE_ID=grupo5-classicmodels
DB_PORT=3306
DB_NAME=classicmodels
DB_USER=admin
DB_PASSWORD=ChangeThisPassword123!

# RDS settings. Keep these unless AWS Academy blocks the instance type.
RDS_INSTANCE_CLASS=db.t3.micro
RDS_ALLOCATED_STORAGE=20
RDS_PUBLICLY_ACCESSIBLE=true

# Usually the AWS Academy role is LabRole.
# The script builds the ARN automatically from your AWS account id.
GLUE_ROLE_NAME=LabRole
